# ==========================================
# DevPilot AI - Environment Variables
# Copy this file to server/.env and fill in the values
# ==========================================

# Server
PORT=5000
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB
# Local:      mongodb://localhost:27017/devpilot-ai
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devpilot-ai
MONGODB_URI=mongodb://localhost:27017/devpilot-ai

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Google Gemini API (https://aistudio.google.com/app/apikey)
# gemini-2.5-flash was retired for new API keys; gemini-3.6-flash is the
# current recommended Flash-tier model. Check https://ai.google.dev/gemini-api/docs/models
# for the latest available model if this ever stops working.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Uploads
MAX_UPLOAD_SIZE_MB=50
