# Base URL for the DevPilot AI backend API.
# In local development this can be left unset - Vite's dev server proxies
# /api requests to http://localhost:5000 automatically (see vite.config.js).
# In production (e.g. Vercel), set this to your deployed backend URL, e.g:
# VITE_API_URL=https://devpilot-ai-api.onrender.com/api
VITE_API_URL=/api
